FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_OPENCLAW_GATEWAY_URL
ARG VITE_OPENCLAW_GATEWAY_TOKEN
ARG VITE_OPENCLAW_AGENT_ID

ENV VITE_OPENCLAW_GATEWAY_URL=$VITE_OPENCLAW_GATEWAY_URL
ENV VITE_OPENCLAW_GATEWAY_TOKEN=$VITE_OPENCLAW_GATEWAY_TOKEN
ENV VITE_OPENCLAW_AGENT_ID=$VITE_OPENCLAW_AGENT_ID

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
